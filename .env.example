# AEMS Configuration Template
# Copy this file to .env and fill in your values

# LLM Provider (claude, openai, gemini, local)
AEMS_PROVIDER=claude

# API Keys (only needed for cloud providers)
AEMS_ANTHROPIC_API_KEY=sk-ant-your-key-here
# AEMS_OPENAI_API_KEY=sk-your-key-here
# AEMS_GEMINI_API_KEY=your-key-here

# Model Settings
AEMS_MODEL=claude-3-5-sonnet-20241022
AEMS_TEMPERATURE=0.2
AEMS_MAX_TOKENS=4096

# OCR Settings
AEMS_OCR_ENGINE=tesseract
AEMS_TESSERACT_LANG=eng
AEMS_OCR_DPI=300

# Layout Detection
AEMS_LAYOUT_MODEL=marker

# Privacy Settings (GDPR compliance)
AEMS_PSEUDONYMIZE=true
AEMS_LOCAL_ONLY=false

# Paths
AEMS_DATA_DIR=./data
AEMS_GOLD_DIR=./gold
AEMS_OUTPUT_DIR=./output

# Logging
AEMS_LOG_LEVEL=INFO
# AEMS_LOG_FILE=./logs/aems.log

# Performance
AEMS_BATCH_SIZE=10
AEMS_MAX_WORKERS=4
